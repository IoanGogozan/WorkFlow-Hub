# Copy to .env on the server and replace every CHANGE_ME value.
POSTGRES_DB=norvixhub
POSTGRES_USER=norvixhub
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Public hostname served by Caddy.
WORKFLOW_HUB_HOST=workflow.norvix.no

# Demo retention and cleanup.
DEMO_CLEANUP_INTERVAL_MINUTES=60
DEMO_CLEANUP_BATCH_SIZE=50

{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=55432;Database=norvixhub;Username=norvixhub;Password=norvixhub_dev_password"
  },
  "Brreg": {
    "BaseUrl": "https://data.brreg.no/enhetsregisteret/api/"
  },
  "ErpDemo": {
    "Enabled": false,
    "FailureDemoEnabled": false
  },
  "SharePoint": {
    "Mode": "Simulated",
    "SimulatedSiteId": "site-demo-service",
    "SimulatedSiteName": "Service Operations Demo",
    "SimulatedDriveId": "drive-shared-documents",
    "SimulatedLibraryName": "Shared Documents",
    "SimulatedPermission": "write",
    "SimulateThrottling": false
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "storage/documents",
      "Container": "documents"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "Container": "documents"
    }
  },
  "DemoSessionCleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "RetentionGraceMinutes": 0,
    "BatchSize": 50
  },
  "RateLimiting": {
    "DemoSessionCreation": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PublicDelivery": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 6291456,
    "Uploads": {
      "MaxFileBytes": 5242880,
      "AllowedFileTypes": [
        {
          "Extension": ".pdf",
          "ContentType": "application/pdf"
        },
        {
          "Extension": ".png",
          "ContentType": "image/png"
        },
        {
          "Extension": ".jpg",
          "ContentType": "image/jpeg"
        },
        {
          "Extension": ".jpeg",
          "ContentType": "image/jpeg"
        }
      ]
    }
  },
  "Deployment": {
    "ForwardedHeadersEnabled": true,
    "EnforceHttps": false,
    "HttpsPort": 443,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [],
    "AllowUnknownProxies": false
  },
  "AllowedHosts": "*"
}
